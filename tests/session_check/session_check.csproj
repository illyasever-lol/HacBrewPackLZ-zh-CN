<Project Sdk="Microsoft.NET.Sdk">

  <!-- The list the GUI, the home screen and Android share, checked against itself. See Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HacBrewPackLz</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="..\..\src\**\*.cs" Exclude="..\..\src\Program.cs;..\..\src\Tui.cs;..\..\src\TuiInside.cs" />
  </ItemGroup>

</Project>
